<Project Sdk="Microsoft.NET.Sdk">

  <!-- Minimal net48 console project used ONLY for local compile verification on
       macOS via: nix shell nixpkgs#dotnet-sdk -c dotnet build -c Release
       The operator compiles on Windows with in-box csc.exe (/langversion:5,
       /r:System.Windows.Forms.dll); keep Day0Gen.cs strictly C# 5. Sole compile-time
       dependency besides System: in-box System.Windows.Forms (engine UI-thread
       marshaling, see Day0Gen.cs FindEngineUiMarshalTarget / RunConstructGenerateSave). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <RootNamespace>Day0Gen</RootNamespace>
    <AssemblyName>Day0Gen</AssemblyName>
    <!-- x64: the game assembly (and its SlimDX/DXVision deps) is 64-bit; type loading fails in a 32-bit process -->
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-box on Windows. Used ONLY to marshal the construct/generate/save
         sequence onto the engine's WinForms UI thread (RunFull). -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
